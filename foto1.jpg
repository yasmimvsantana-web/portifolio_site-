// ─── DATA ───
  const trimNames = ['1º Trimestre', '2º Trimestre', '3º Trimestre'];

  const subjects = [
    {
      id: 1,
      name: 'Matemática',
      label: 'Exatas',
      trimestres: [
        [{ title: 'Clique em + para adicionar', desc: 'Adicione sua primeira atividade de Matemática — 1º Trimestre.', img: null }],
        [{ title: 'Clique em + para adicionar', desc: 'Adicione sua primeira atividade de Matemática — 2º Trimestre.', img: null }],
        [{ title: 'Clique em + para adicionar', desc: 'Adicione sua primeira atividade de Matemática — 3º Trimestre.', img: null }],
      ]
    },
    {
      id: 2,
      name: 'Linguagens',
      label: 'Port. · Literatura · Arte',
      trimestres: [
        [{ title: 'Clique em + para adicionar', desc: 'Adicione sua primeira atividade de Linguagens — 1º Trimestre.', img: null }],
        [{ title: 'Clique em + para adicionar', desc: 'Adicione sua primeira atividade de Linguagens — 2º Trimestre.', img: null }],
        [{ title: 'Clique em + para adicionar', desc: 'Adicione sua primeira atividade de Linguagens — 3º Trimestre.', img: null }],
      ]
    },
    {
      id: 3,
      name: 'Humanas',
      label: 'Hist. · Geo. · Fil. · Soc.',
      trimestres: [
        [{ title: 'Clique em + para adicionar', desc: 'Adicione sua primeira atividade de Humanas — 1º Trimestre.', img: null }],
        [{ title: 'Clique em + para adicionar', desc: 'Adicione sua primeira atividade de Humanas — 2º Trimestre.', img: null }],
        [{ title: 'Clique em + para adicionar', desc: 'Adicione sua primeira atividade de Humanas — 3º Trimestre.', img: null }],
      ]
    },
    {
      id: 4,
      name: 'Natureza',
      label: 'Física · Química · Biologia',
      trimestres: [
        [{ title: 'Clique em + para adicionar', desc: 'Adicione sua primeira atividade de Natureza — 1º Trimestre.', img: null }],
        [{ title: 'Clique em + para adicionar', desc: 'Adicione sua primeira atividade de Natureza — 2º Trimestre.', img: null }],
        [{ title: 'Clique em + para adicionar', desc: 'Adicione sua primeira atividade de Natureza — 3º Trimestre.', img: null }],
      ]
    }
  ];

  // active trimestre per folder
  const activeTri  = { 1: 0, 2: 0, 3: 0, 4: 0 };
  // active slide per folder per trimestre
  const currentSlide = {
    1: [0,0,0], 2: [0,0,0], 3: [0,0,0], 4: [0,0,0]
  };

  // ─── RENDER ───
  function renderFolders() {
    const grid = document.getElementById('folders-grid');
    grid.innerHTML = '';
    subjects.forEach((sub, idx) => {
      const folderClass = `folder-${idx + 1}`;
      const tri  = activeTri[sub.id];
      const acts = sub.trimestres[tri];
      const ci   = currentSlide[sub.id][tri];
      const total = acts.length;

      const folder = document.createElement('div');
      folder.className = `folder ${folderClass}`;
      folder.dataset.id = sub.id;

      folder.innerHTML = `
        <!-- TABS ROW -->
        <div class="folder-tabs-row">
          ${trimNames.map((t, ti) => `
            <div class="tri-tab ${ti === tri ? 'active' : ''}"
                 data-subid="${sub.id}" data-tri="${ti}">${t}</div>
          `).join('')}
        </div>

        <!-- BODY -->
        <div class="folder-body">
          <span class="tri-badge">${trimNames[tri]}</span>
          <div class="folder-header">
            <div>
              <div class="folder-title">${sub.name}</div>
              <div class="folder-label">${sub.label}</div>
            </div>
            <div class="page-counter">${ci + 1} / ${total}</div>
          </div>

          <div class="slider-wrapper">
            <div class="slides-track" id="track-${sub.id}" style="transform:translateX(-${ci * 100}%)">
              ${acts.map((act, i) => `
                <div class="activity-slide">
                  <div class="activity-title" contenteditable="true" spellcheck="false"
                       data-subid="${sub.id}" data-tri="${tri}" data-actidx="${i}" data-field="title">${act.title}</div>
                  <div class="activity-desc" contenteditable="true" spellcheck="false"
                       data-subid="${sub.id}" data-tri="${tri}" data-actidx="${i}" data-field="desc">${act.desc}</div>
                  <div class="activity-img-wrap" data-subid="${sub.id}" data-tri="${tri}" data-actidx="${i}" title="Clique para adicionar imagem">
                    ${act.img
                      ? `<img src="${act.img}" alt="Imagem da atividade"/>`
                      : `<div class="img-placeholder">
                           <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                             <rect x="3" y="3" width="18" height="18" rx="3"/><circle cx="8.5" cy="8.5" r="1.5"/>
                             <polyline points="21 15 16 10 5 21"/>
                           </svg>
                           <span>Adicionar imagem</span>
                         </div>`
                    }
                  </div>
                </div>
              `).join('')}
            </div>
          </div>

          <div class="slider-nav">
            <button class="nav-btn prev-btn" data-id="${sub.id}" aria-label="Anterior">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="15 18 9 12 15 6"/>
              </svg>
            </button>
            <div class="dots">
              ${acts.map((_, i) =>
                `<span class="dot ${i === ci ? 'active' : ''}" data-id="${sub.id}" data-idx="${i}"></span>`
              ).join('')}
            </div>
            <button class="nav-btn next-btn" data-id="${sub.id}" aria-label="Próximo">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="9 18 15 12 9 6"/>
              </svg>
            </button>
          </div>

          <button class="add-activity-btn" data-id="${sub.id}" style="margin-top:12px">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/>
            </svg>
            Nova atividade
          </button>
        </div>
      `;
      grid.appendChild(folder);
    });

    bindEvents();
  }

  // ─── SLIDE ───
  function goTo(subId, idx) {
    const tri  = activeTri[subId];
    const acts = subjects.find(s => s.id === subId).trimestres[tri];
    if (idx < 0) idx = acts.length - 1;
    if (idx >= acts.length) idx = 0;
    currentSlide[subId][tri] = idx;
    renderFolders();
  }

  // ─── BIND EVENTS ───
  function bindEvents() {
    // Trimestre tabs
    document.querySelectorAll('.tri-tab').forEach(tab => {
      tab.addEventListener('click', () => {
        const subId = +tab.dataset.subid;
        const tri   = +tab.dataset.tri;
        activeTri[subId] = tri;
        renderFolders();
      });
    });

    // Prev / Next
    document.querySelectorAll('.prev-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        const id = +btn.dataset.id;
        const tri = activeTri[id];
        goTo(id, currentSlide[id][tri] - 1);
      });
    });
    document.querySelectorAll('.next-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        const id = +btn.dataset.id;
        const tri = activeTri[id];
        goTo(id, currentSlide[id][tri] + 1);
      });
    });

    // Dots
    document.querySelectorAll('.dot').forEach(dot => {
      dot.addEventListener('click', () => {
        goTo(+dot.dataset.id, +dot.dataset.idx);
      });
    });

    // Add activity
    document.querySelectorAll('.add-activity-btn').forEach(btn => {
      btn.addEventListener('click', () => openModal(+btn.dataset.id));
    });

    // Inline edit
    document.querySelectorAll('[contenteditable][data-field]').forEach(el => {
      el.addEventListener('blur', () => {
        const subId  = +el.dataset.subid;
        const tri    = +el.dataset.tri;
        const actIdx = +el.dataset.actidx;
        const field  = el.dataset.field;
        subjects.find(s => s.id === subId).trimestres[tri][actIdx][field] = el.innerText;
      });
    });

    // Image click on activity
    document.querySelectorAll('.activity-img-wrap').forEach(wrap => {
      wrap.addEventListener('click', () => {
        const subId  = +wrap.dataset.subid;
        const tri    = +wrap.dataset.tri;
        const actIdx = +wrap.dataset.actidx;
        const inp = document.createElement('input');
        inp.type = 'file';
        inp.accept = 'image/*';
        inp.onchange = e => {
          const file = e.target.files[0];
          if (!file) return;
          const reader = new FileReader();
          reader.onload = ev => {
            subjects.find(s => s.id === subId).trimestres[tri][actIdx].img = ev.target.result;
            activeTri[subId] = tri;
            currentSlide[subId][tri] = actIdx;
            renderFolders();
          };
          reader.readAsDataURL(file);
        };
        inp.click();
      });
    });
  }

  // ─── MODAL ───
  let activeSubId = null;

  function openModal(subId) {
    activeSubId = subId;
    document.getElementById('modal-title').value = '';
    document.getElementById('modal-desc').value = '';
    document.getElementById('modal-overlay').classList.add('open');
    setTimeout(() => document.getElementById('modal-title').focus(), 100);
  }

  function closeModal() {
    document.getElementById('modal-overlay').classList.remove('open');
    activeSubId = null;
  }

  document.getElementById('modal-close').addEventListener('click', closeModal);
  document.getElementById('modal-cancel').addEventListener('click', closeModal);
  document.getElementById('modal-overlay').addEventListener('click', e => {
    if (e.target === e.currentTarget) closeModal();
  });

  document.getElementById('modal-save').addEventListener('click', () => {
    const title = document.getElementById('modal-title').value.trim() || 'Nova Atividade';
    const desc  = document.getElementById('modal-desc').value.trim() || 'Descrição da atividade.';
    const sub   = subjects.find(s => s.id === activeSubId);
    sub.activities.push({ title, desc, img: null });
    const newIdx = sub.activities.length - 1;
    closeModal();
    goTo(activeSubId, newIdx);
  });

  // ─── PHOTO UPLOAD ───
  document.getElementById('photo-input').addEventListener('change', e => {
    const file = e.target.files[0];
    if (!file) return;
    const reader = new FileReader();
    reader.onload = ev => {
      document.getElementById('photo-placeholder').style.display = 'none';
      const img = document.getElementById('profile-img');
      img.src = ev.target.result;
      img.style.display = 'block';
    };
    reader.readAsDataURL(file);
  });

  // ─── LIFE CAROUSEL ───
  const lifeTotal = 14;
  let lifeCurrent = 0;

  const lifeTrack = document.getElementById('life-track');
  const lifeDotsWrap = document.getElementById('life-dots');

  // Build dots
  for (let i = 0; i < lifeTotal; i++) {
    const d = document.createElement('span');
    d.className = 'life-dot' + (i === 0 ? ' active' : '');
    d.addEventListener('click', () => lifeGoTo(i));
    lifeDotsWrap.appendChild(d);
  }

  function lifeGoTo(idx) {
    if (idx < 0) idx = lifeTotal - 1;
    if (idx >= lifeTotal) idx = 0;
    lifeCurrent = idx;
    lifeTrack.style.transform = `translateX(-${lifeCurrent * 100}%)`;
    document.querySelectorAll('.life-dot').forEach((d, i) => {
      d.classList.toggle('active', i === lifeCurrent);
    });
  }

  document.getElementById('life-prev').addEventListener('click', () => lifeGoTo(lifeCurrent - 1));
  document.getElementById('life-next').addEventListener('click', () => lifeGoTo(lifeCurrent + 1));

  // Auto-advance every 4s
  setInterval(() => lifeGoTo(lifeCurrent + 1), 4000);

  // Touch/swipe support
  let touchStartX = 0;
  lifeTrack.addEventListener('touchstart', e => { touchStartX = e.touches[0].clientX; }, { passive: true });
  lifeTrack.addEventListener('touchend', e => {
    const dx = e.changedTouches[0].clientX - touchStartX;
    if (Math.abs(dx) > 40) lifeGoTo(lifeCurrent + (dx < 0 ? 1 : -1));
  });

  // ─── NAVIGATION ───
  document.querySelectorAll('.nav-link').forEach(link => {
    link.addEventListener('click', e => {
      e.preventDefault();
      const page = link.dataset.page;

      document.querySelectorAll('.nav-link').forEach(l => l.classList.remove('active'));
      link.classList.add('active');

      document.querySelectorAll('.page').forEach(p => p.classList.remove('active'));
      document.getElementById('page-' + page).classList.add('active');

      window.scrollTo({ top: 0, behavior: 'smooth' });
    });
  });

  // ─── INIT ───
  renderFolders();